#!/usr/bin/env bash
# bin/continuity-server — MCP server entry point.
#
# Runs continuity's MCP server over stdio. Claude Code spawns this as a
# subprocess per the .mcp.json registration.
set -euo pipefail
CONTINUITY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec python3 "$CONTINUITY_ROOT/lib/server.py" "$@"
