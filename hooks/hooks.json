{
  "description": "continuity lifecycle hooks",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CONTINUITY_ROOT}/hooks/session-end.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CONTINUITY_ROOT}/hooks/pre-compact.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
